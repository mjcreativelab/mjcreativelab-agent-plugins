  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Slack__slack_read_channel|mcp__claude_ai_Slack__slack_read_thread",
        "hooks": [
          {
            "type": "command",
            "command": "channel=$(jq -r '.tool_input.channel_id // .tool_input.channel // empty' 2>/dev/null); if [[ \"$channel\" =~ ^[DG] ]]; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Slack DM の読み取りは禁止されています\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo \"$TOOL_INPUT\" | sed -n 's/.*\"file_path\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p'); case \"$FILE\" in */.env|*/.env.*) case \"$FILE\" in */.env.sample|*/.env.sample.*) ;; *) echo \"BLOCK: .env 系ファイル ($FILE) への直接書き込みは禁止です。.env.sample を編集してください。\" >&2; exit 2 ;; esac ;; esac"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(echo \"$TOOL_INPUT\" | sed -n 's/.*\"command\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\"/\\1/p'); if echo \"$CMD\" | grep -qE '(>|>>|tee|sed|cp).*\\.env' && ! echo \"$CMD\" | grep -qE '\\.env\\.sample'; then echo 'BLOCK: Bash 経由での .env 系ファイル操作は禁止です。' >&2; exit 2; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(echo \"$TOOL_INPUT\" | sed -n 's/.*\"command\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\"/\\1/p'); if echo \"$CMD\" | grep -qE 'git\\s+commit'; then if git branch --show-current 2>/dev/null | grep -qE '^main$'; then echo 'BLOCK: main ブランチへの直接コミットは禁止です。feature branch を使ってください。' >&2; exit 2; fi; fi; if echo \"$CMD\" | grep -qE 'git\\s+push'; then if git branch --show-current 2>/dev/null | grep -qE '^main$'; then echo 'BLOCK: main ブランチからの push は禁止です。feature branch を使ってください。' >&2; exit 2; fi; if echo \"$CMD\" | grep -qE 'git\\s+push\\s+.*(:main|HEAD:main|\\smain$|\\smain\\s)'; then echo 'BLOCK: main ブランチへの直接 push は禁止です。PR 経由でマージしてください。' >&2; exit 2; fi; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(echo \"$TOOL_INPUT\" | sed -n 's/.*\"command\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\"/\\1/p'); if echo \"$CMD\" | grep -qE 'git\\s+(reset\\s+--hard|push\\s+--force|push\\s+-f\\b|push\\s+.*--force-with-lease|clean\\s+-[a-zA-Z]*[fx]|checkout\\s+--\\s+\\.|branch\\s+-D)'; then echo 'BLOCK: 破壊的 git 操作を検出しました。この操作は禁止されています。' >&2; exit 2; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/Music/ffxiv_sps05001_mp3/FFXIV_Notification.mp3"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-compact-save-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q '\"file_path\".*CLAUDE\\.md\"'; then DIR=$(echo \"$TOOL_INPUT\" | sed -n 's/.*\"file_path\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\\/CLAUDE\\.md\".*/\\1/p'); if [ -n \"$DIR\" ]; then AGENTS=\"$DIR/AGENTS.md\"; if [ ! -L \"$AGENTS\" ]; then rm -f \"$AGENTS\" 2>/dev/null; ln -s CLAUDE.md \"$AGENTS\"; fi; fi; fi"
          }
        ]
      }
    ]
  },
